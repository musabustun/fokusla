// Fokus — kimlikler ve ortak derleme ayarları. TEK KAYNAK: bundle ID, iCloud kapsayıcısı ve takım
// burada; project.yml, Info.plist ve entitlements bu değişkenleri kullanır.
//
// Apple tarafında kayıtlı olması gerekenler (cihaz imzalama için; bkz. ios/README.md):
//   App ID  : com.musabustun.fokus  (iCloud/CloudKit, Sign in with Apple, Push Notifications)
//   iCloud  : iCloud.com.musabustun.fokus

PRODUCT_BUNDLE_IDENTIFIER = com.musabustun.fokus
FOKUS_ICLOUD_CONTAINER = iCloud.com.musabustun.fokus
DEVELOPMENT_TEAM = 395SFU52ZD
CODE_SIGN_STYLE = Automatic

MARKETING_VERSION = 1.0.1
CURRENT_PROJECT_VERSION = 6

IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Spotify App Remote (isteğe bağlı entegrasyon). BOŞ varsayılan: entegrasyon gizlenir, yerine "Spotify'da aç"
// bağlantısı gösterilir. Client ID gizli değildir ama yine de kodda değil burada durur. Kurulum: ios/README.md.
// Redirect URI (fokus://spotify-callback) kodda sabittir: xcconfig'te `//` yorum başlatır.
SPOTIFY_CLIENT_ID =

// Yerel, git dışı geçersiz kılmalar (ör. SPOTIFY_CLIENT_ID). Dosya yoksa yok sayılır. Bkz. ios/README.md.
#include? "Local.xcconfig"
